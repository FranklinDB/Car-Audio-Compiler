def intro():
    print('Welcome to the Car Audio Configurator')
    print('The purpose of this program is to assist you with car audio component selection')
    print('The program will ask you various questions to create the best lists of parts possible')

def get_vehicle_info():
    vehicle_type = input('What Body Style is your vehicle (Sedan, Crossover, SUV, Truck): ').lower()
    vehicle_options = ['sedan', 'crossover', 'suv', 'truck']
    while vehicle_type not in vehicle_options:
        print('there was an error entering your vehicle type please try again')
        vehicle_type = input('What Body Style is your vehicle (Sedan, Crossover, SUV, Truck): ').lower()
    if vehicle_type == 'truck':
        print("This feature is still under development")
    system_parameters['body style'] = vehicle_type

def get_listening_preferences():
    box_info = input('Would you like help choosing your subwoofer enclosure type? (Enter "yes" or "no"): ')
    if box_info == 'yes':
        print()
        print('To create the best possible system it is important to choose a subwoofer enclosure to match what music you listen to')
        print()
        print('Ported Enclosures are more efficient and tend to be more boomy ')
        print('This makes them a great choice for bass heavy or music such as rap or EDM')
        print()
        print('Sealed boxes however are less efficent,  but are more musically accurate as well as more punchy')
        print('Their "punchy" nature is more effective for reproducting bass such as kick drums found in country or rock')
        print()
        ask_box_type = input('Type "sealed" or "ported" to select your enclosure type: ')
        bass_parameters['box type'] = ask_box_type
    else:
        ask_box_type = input('Type "sealed" or "ported" to select your enclosure type: ')
        bass_parameters['box type'] = ask_box_type
    print('How much bass are you looking for')
    print('Enter 1 for a little more than my factory system')
    print('Enter 2 for I want to hear the bass in every song')
    print('Enter 3 for I want to feel it in my chest')
    ask_bass_amount = input()
    bass_parameters['bass amount'] = ask_bass_amount
    print('How important is sound quality to you')
    print('Type 1 for: Sound Quality is my first priority over output and bass')
    print('Type 2 for: I like a good balance of sound quality and output')
    print('Type 3 for: I prioritze bass and output over sound quality')
    ask_sound_quality = input('Select An Option:')
    listening_preferences['sound quality'] == ask_sound_quality

